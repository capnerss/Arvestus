<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TicTacToe.Controls"
             x:Class="TicTacToe.Views.ShopPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <Grid RowDefinitions="*, Auto">

        <!-- Scrollable Shop Content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16"
                                 Padding="20, 16, 20, 28"
                                 MaximumWidthRequest="460">

                <!-- Duolingo Stiilis Päis -->
                <Border x:Name="ShopHeaderBanner"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#1CB0F6"
                        Stroke="#0E88C7"
                        StrokeThickness="0"
                        Padding="16, 12">
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        
                        <!-- Close Button (Tagasi pealehele) -->
                        <Border Grid.Column="0"
                                x:Name="ShopBackBtn"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#0E88C7"
                                StrokeThickness="0"
                                WidthRequest="38"
                                HeightRequest="38"
                                VerticalOptions="Center"
                                ToolTipProperties.Text="Tagasi pealehele">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="✕"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Title -->
                        <Label Grid.Column="1"
                               Text="POOD"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <!-- Coins Pill Balance -->
                        <Border Grid.Column="2"
                                x:Name="ShopCoinsPill"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#0E88C7"
                                StrokeThickness="0"
                                HeightRequest="38"
                                Padding="10, 4"
                                VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Image Source="duo_coin.png"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       Aspect="AspectFit"
                                       VerticalOptions="Center" />
                                <Label x:Name="LblShopCoins"
                                       Text="500"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== A. ELUDE SEKTSIOON ==================== -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="ELUD"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#4B4B4B" />

                    <!-- Item 1: +1 Life Hero Card with 3D tactile button -->
                    <Border StrokeShape="RoundRectangle 18"
                            BackgroundColor="White"
                            Stroke="#E5E5E5"
                            StrokeThickness="2"
                            Padding="16, 14">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#FEF2F2"
                                    Stroke="#FECACA"
                                    StrokeThickness="1"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    VerticalOptions="Center">
                                <Image Source="duo_heart.png"
                                       WidthRequest="30"
                                       HeightRequest="30"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="+1 Elu"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#2B2B2B" />
                                <Label x:Name="LblLivesStatus"
                                       Text="Praegu: 10 / 10 elu"
                                       FontSize="12"
                                       TextColor="#777777" />
                            </VerticalStackLayout>

                            <Grid Grid.Column="2" HeightRequest="40" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#D97706"
                                        StrokeThickness="0"
                                        Margin="0, 3, 0, 0" />
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#FF9600"
                                        StrokeThickness="0"
                                        Padding="14, 0"
                                        Margin="0, 0, 0, 3">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBuyOneLifeClicked" />
                                    </Border.GestureRecognizers>
                                    <Label Text="50 🪙"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== B. AVATARIDE SEKTSIOON ==================== -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="AVATARID"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#4B4B4B" />

                    <!-- Avatar 2-Column Grid -->
                    <Grid x:Name="AvatarsGrid"
                          ColumnDefinitions="*, *"
                          ColumnSpacing="12"
                          RowSpacing="12" />
                </VerticalStackLayout>

                <!-- ==================== C. TEEMADE SEKTSIOON ==================== -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="TEEMAD"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#4B4B4B" />

                    <!-- Themes 2-Column Grid -->
                    <Grid x:Name="ThemesGrid"
                          ColumnDefinitions="*, *"
                          ColumnSpacing="12"
                          RowSpacing="12" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Duolingo Footer -->
        <controls:DuolingoFooter Grid.Row="1" ActiveTab="More" />

        <!-- 3. Bottom Sheet Modal Overlay (Asendab DisplayAlerti) -->
        <Grid Grid.RowSpan="2"
              x:Name="BottomSheetOverlay"
              IsVisible="False"
              BackgroundColor="#70000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBottomSheetScrimTapped" />
            </Grid.GestureRecognizers>

            <Border x:Name="BottomSheetCard"
                    VerticalOptions="End"
                    StrokeShape="RoundRectangle 24, 24, 0, 0"
                    BackgroundColor="White"
                    Stroke="#E5E5E5"
                    StrokeThickness="1"
                    Padding="24, 16, 24, 28"
                    MaximumWidthRequest="460"
                    HorizontalOptions="Fill">
                <Border.GestureRecognizers>
                    <!-- Catch taps inside bottom sheet so clicking it doesn't dismiss it -->
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="16">
                    <!-- Tõmberiba (handle) -->
                    <BoxView WidthRequest="40"
                             HeightRequest="4"
                             CornerRadius="2"
                             BackgroundColor="#D1D5DB"
                             HorizontalOptions="Center" />

                    <!-- Ikoon ja teated -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border x:Name="SheetIconBorder"
                                StrokeShape="RoundRectangle 22"
                                BackgroundColor="#FEF3C7"
                                Stroke="#FCD34D"
                                StrokeThickness="2"
                                WidthRequest="70"
                                HeightRequest="70"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Image x:Name="SheetIconImage"
                                   Source="duo_coin.png"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Label x:Name="SheetTitle"
                               Text="Kinnita ost"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#2B2B2B"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <Label x:Name="SheetMessage"
                               Text="Kas soovid osta...?"
                               FontSize="14"
                               TextColor="#6B7280"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineHeight="1.2" />
                    </VerticalStackLayout>

                    <!-- Nupud: Kinnitamine (Osta / Loobu) -->
                    <VerticalStackLayout x:Name="SheetConfirmActions" Spacing="10">
                        <Border x:Name="SheetBuyButtonBorder"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="#1CB0F6"
                                Stroke="#0E88C7"
                                StrokeThickness="0"
                                HeightRequest="50">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfirmPurchaseClicked" />
                            </Border.GestureRecognizers>
                            <Label x:Name="LblSheetBuyButton"
                                   Text="OSTA"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="#F7F7F7"
                                Stroke="#E5E5E5"
                                StrokeThickness="1.5"
                                HeightRequest="46">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancelPurchaseClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="LOOBU"
                                   TextColor="#777777"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Nupud: Teade (Münte pole piisavalt jms) -->
                    <VerticalStackLayout x:Name="SheetAlertActions" Spacing="10" IsVisible="False">
                        <Border x:Name="SheetAlertButtonBorder"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="#1CB0F6"
                                Stroke="#1899D6"
                                StrokeThickness="0"
                                HeightRequest="50">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseAlertSheetClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="SELGUS"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>

